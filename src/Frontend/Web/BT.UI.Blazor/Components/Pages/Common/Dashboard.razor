@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IBackendApiClient Client
@inject TimeProvider Clock
@using BT.SharedKernel.Features.Shared.OrgSettings

<PageTitle>Dashboard | BaseTemplate</PageTitle>
<section class="dashboard-page">
    <div class="panel-heading">
        <h2>Dashboard</h2>
        <MudText Typo="Typo.body2">Welcome, @AuthSession.CurrentUser?.FirstName</MudText>
    </div>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    @if (_message is not null)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true">@_message</MudAlert>
    }
    @if (AuthSession.CurrentUser?.IsPlatformStaff == true)
    {
        <MudGrid Spacing="2">
            @foreach (var metric in _metrics)
            {
                <MudItem xs="12"
                         sm="6"
                         md="3">
                    <MudPaper Class="@($"pa-4 dashboard-accent-card dashboard-accent-{metric.Accent}")"
                              Elevation="0">
                        <MudText Typo="Typo.body2">@metric.Label</MudText>
                        <MudText Typo="Typo.h5">@metric.Value</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        @if (AuthSession.HasPermission("controlplane.view_tenants"))
        {
            <MudButton Href="/control-panel/tenants?status=ProvisioningFailed"
                       StartIcon="@Icons.Material.Filled.Warning"
                       Class="mt-4">Review provisioning failures</MudButton>
        }
        <MudButton Href="/control-panel"
                   StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                   Class="mt-4">Control Panel</MudButton>
    }
    else if (AuthSession.CurrentUser is { } user)
    {
        <MudPaper Class="pa-4 dashboard-accent-card"
                  Elevation="0">
            <MudText Typo="Typo.h6">@(user.OrganizationPreferences?.Name ?? "Your organization")</MudText>
            <MudText Typo="Typo.body2">Organization time: @OrganizationFormatting.FormatDate(Clock.GetUtcNow(), user.OrganizationPreferences)</MudText>
            @if (user.LastLoginAt is { } lastLogin)
            {
                <MudText Typo="Typo.body2">Last sign-in: @OrganizationFormatting.FormatDate(lastLogin, user.OrganizationPreferences)</MudText>
            }
            <MudText Typo="Typo.body2">Your roles: @string.Join(", ", user.Roles)</MudText>
            <MudText Typo="Typo.body2">Available modules: @string.Join(", ", user.EnabledModules ?? [])</MudText>
        </MudPaper>
    }
</section>

@code {
    private bool _loading = true;
    private string? _message;
    private readonly List<(string Label, string Value, string Accent)> _metrics = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthSession.InitializeAsync();
        if (AuthSession.CurrentUser?.IsPlatformStaff == true && AuthSession.HasPermission("controlplane.view_tenants"))
        {
            var response = await Client.SendAsync<PlatformDashboardResponse>(HttpMethod.Get, "api/v1/control-plane/tenants/dashboard");
            if (response.IsSuccess && response.Data is { } metrics)
            {
                _metrics.Add(("Tenants", metrics.Tenants.ToString(System.Globalization.CultureInfo.InvariantCulture), "primary"));
                _metrics.Add(("Active tenants", metrics.Active.ToString(System.Globalization.CultureInfo.InvariantCulture), "success"));
                _metrics.Add(("Suspended tenants", metrics.Suspended.ToString(System.Globalization.CultureInfo.InvariantCulture), "neutral"));
                _metrics.Add(("Awaiting KYC", metrics.PendingKyc.ToString(System.Globalization.CultureInfo.InvariantCulture), "warning"));
                _metrics.Add(("Provisioning", metrics.Provisioning.ToString(System.Globalization.CultureInfo.InvariantCulture), "info"));
                _metrics.Add(("Provisioning failures", metrics.ProvisioningFailed.ToString(System.Globalization.CultureInfo.InvariantCulture), "danger"));
                if (metrics.InvitationsPending is { } pending) _metrics.Add(("Invitations pending", pending.ToString(System.Globalization.CultureInfo.InvariantCulture), "warning"));
                if (metrics.InvitationsFailed is { } failed) _metrics.Add(("Invitation failures", failed.ToString(System.Globalization.CultureInfo.InvariantCulture), "danger"));
                if (metrics.ActiveStamps is { } stamps) _metrics.Add(("Active stamps", stamps.ToString(System.Globalization.CultureInfo.InvariantCulture), "success"));
                if (metrics.DisabledStamps is { } disabled) _metrics.Add(("Disabled stamps", disabled.ToString(System.Globalization.CultureInfo.InvariantCulture), "neutral"));
            }
            else _message = response.Message ?? "Platform metrics are unavailable.";
        }
        _loading = false;
        StateHasChanged();
    }
}
