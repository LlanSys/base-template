@inject ITenantService TenantService
@inject BT.UI.Blazor.Features.ControlPlane.Modules.ModuleService Modules
@inject ISnackbar Snackbar
@using BT.SharedKernel.Features.ControlPlane.Modules
<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">Modules available to @ExistingTenant.DisplayName</MudText>
        <MudTable Items="_modules"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh>Enabled</MudTh>
                <MudTh>Module</MudTh>
                <MudTh>Catalog status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool"
                                 Value="@_selected.Contains(context.Key)"
                                 ValueChanged="@(value => Select(context.Key, value))"
                                 Disabled="@(_busy || !context.IsActive && !_selected.Contains(context.Key))"
                                 Dense="true" />
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@(context.IsActive ? "Available" : "Disabled by vendor")</MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close"
                   OnClick="@(() => Dialog.Cancel())"
                   Disabled="_busy">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   Disabled="@(_busy || _loading)">Save</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public TenantResponse ExistingTenant { get; set; } = default!;
    private List<ModuleDefinitionResponse> _modules = [];
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private bool _busy, _loading = true;
    protected override async Task OnInitializedAsync()
    {
        var response = await Modules.GetAsync();
        if (response.IsSuccess && response.Data is not null)
        {
            _modules = response.Data;
            _selected.UnionWith(ExistingTenant.EnabledModules.Where(ModuleCatalog.IsImplemented)
                .Where(key => _modules.Any(module => string.Equals(module.Key, key, StringComparison.OrdinalIgnoreCase))));
            _loading = false;
        }
        else Snackbar.Add(response.Message ?? "Module catalog could not be loaded.", Severity.Error);
    }
    private void Select(string key, bool value) { if (value) _selected.Add(key); else _selected.Remove(key); }
    private async Task SaveAsync()
    {
        _busy = true;
        var response = await TenantService.SetModulesAsync(ExistingTenant.Id, new(_selected.ToArray()));
        _busy = false;
        if (response.IsSuccess) Dialog.Close(DialogResult.Ok(true));
        else Snackbar.Add(response.Message ?? "Module assignments could not be saved.", Severity.Error);
    }
}
