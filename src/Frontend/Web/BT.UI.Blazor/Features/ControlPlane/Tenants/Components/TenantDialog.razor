@inject ITenantService TenantService
@inject IDeploymentStampService StampService
@inject ISnackbar Snackbar
@inject BT.UI.Blazor.Features.ControlPlane.Modules.ModuleService Modules
@using BT.SharedKernel.Features.ControlPlane.Modules

<MudDialog>
    <DialogContent>
        <EditForm FormName="control-plane-tenant-form"
                  Model="_model"
                  OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.DisplayName"
                                  Label="Display Name"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Required />
                </MudItem>
                @if (ExistingTenant is null)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Identifier"
                                      Label="Identifier (URL-safe)"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Outlined"
                                      Required
                                      HelperText="Lowercase letters, numbers, and hyphens only (e.g. acme-corp)" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.HostName"
                                  Label="Hostname"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Required />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ContactEmail"
                                  Label="Contact email"
                                  InputType="InputType.Email"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="int"
                                     @bind-Value="_model.MaxUsers"
                                     Label="User limit (0 = unlimited)"
                                     Min="0"
                                     Margin="Margin.Dense"
                                     Variant="Variant.Outlined" />
                </MudItem>
                @if (ExistingTenant is null)
                {
                    <MudItem xs="12">
                        <MudSelect T="string"
                                   @bind-Value="_model.SubscriptionTier"
                                   Label="Subscription Tier"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Required>
                            <MudSelectItem T="string"
                                           Value="@("Free")">Free</MudSelectItem>
                            <MudSelectItem T="string"
                                           Value="@("Basic")">Basic</MudSelectItem>
                            <MudSelectItem T="string"
                                           Value="@("Premium")">Premium</MudSelectItem>
                            <MudSelectItem T="string"
                                           Value="@("Enterprise")">Enterprise</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="Guid?"
                                   @bind-Value="_model.DeploymentStampId"
                                   Label="Deployment Stamp"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined"
                                   Required>
                            @foreach (var stamp in _stamps)
                            {
                                <MudSelectItem T="Guid?"
                                               Value="@stamp.Id">@stamp.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                @if (ExistingTenant is null)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2">Business modules</MudText>
                        @foreach (var module in _modules)
                        {
                            <MudCheckBox T="bool"
                                         Value="@_selectedModules.Contains(module.Key)"
                                         ValueChanged="@(value => SelectModule(module.Key, value))"
                                         Label="@module.Name"
                                         Dense="true" />
                        }
                    </MudItem>
                }
            </MudGrid>
            @if (ExistingTenant is null)
            {
                <MudText Typo="Typo.subtitle2"
                         Class="mt-4">Initial organization administrator</MudText>
                <MudTextField @bind-Value="_administratorEmail"
                              Label="Administrator email"
                              Required="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_administratorFirstName"
                              Label="First name"
                              Required="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_administratorLastName"
                              Label="Last name"
                              Required="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />
                <MudText Typo="Typo.caption">An invitation is delivered after activation. No password is shared.</MudText>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Color="Color.Default"
                   OnClick="Cancel">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Success"
                   Disabled="_isSaving"
                   OnClick="SaveAsync">@(_isSaving ? "Saving..." : SaveLabel)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private TenantFormModel _model = new();
    private bool _isSaving;
    private string _administratorEmail = string.Empty, _administratorFirstName = string.Empty, _administratorLastName = string.Empty;
    private List<DeploymentStampResponse> _stamps = [];
    private List<ModuleDefinitionResponse> _modules = [];
    private readonly HashSet<string> _selectedModules = new(StringComparer.OrdinalIgnoreCase);
    private void SelectModule(string key, bool selected) { if (selected) _selectedModules.Add(key); else _selectedModules.Remove(key); }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public TenantResponse? ExistingTenant { get; set; }

    private string SaveLabel => ExistingTenant is null ? "Create" : "Update";

    protected override async Task OnInitializedAsync()
    {
        _model = ExistingTenant is null
            ? new TenantFormModel()
            : TenantFormModel.From(ExistingTenant);

        if (ExistingTenant is null)
        {
            var modules = await Modules.GetAsync();
            if (modules.IsSuccess && modules.Data is not null) _modules = modules.Data.Where(module => module.IsActive).ToList();
            var stampsResponse = await StampService.GetAllAsync();
            if (stampsResponse.IsSuccess && stampsResponse.Data is not null)
            {
                _stamps = stampsResponse.Data.Where(stamp => stamp.IsActive).ToList();
            }
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.DisplayName) || 
            string.IsNullOrWhiteSpace(_model.HostName) || 
            (ExistingTenant is null && string.IsNullOrWhiteSpace(_model.Identifier)))
        {
            Snackbar.Add("Display Name, Identifier, and Hostname are required.", Severity.Warning);
            return;
        }

        if (ExistingTenant is null && (_model.DeploymentStampId is null || _model.DeploymentStampId == Guid.Empty))
        {
            Snackbar.Add("A deployment stamp must be selected.", Severity.Warning);
            return;
        }

        if (ExistingTenant is null && _selectedModules.Count == 0)
        { Snackbar.Add("Select at least one business module.", Severity.Warning); return; }
        if (ExistingTenant is null && (string.IsNullOrWhiteSpace(_administratorEmail) || string.IsNullOrWhiteSpace(_administratorFirstName) || string.IsNullOrWhiteSpace(_administratorLastName)))
        { Snackbar.Add("Initial administrator details are required.", Severity.Warning); return; }
        _model.InitialAdministrator = new(_administratorEmail.Trim(), _administratorFirstName.Trim(), _administratorLastName.Trim());
        _model.ModuleKeys = _selectedModules.ToArray();
        _isSaving = true;
        var response = ExistingTenant is null
            ? await TenantService.CreateAsync(_model.ToCreateRequest())
            : await TenantService.UpdateAsync(_model.Id, _model.ToUpdateRequest());
        _isSaving = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Tenant save failed.", Severity.Error);
            return;
        }

        Snackbar.Add(ExistingTenant is null ? "Tenant created. Administrator invitation is queued for activation." : "Tenant updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class TenantFormModel
    {
        public InviteTenantAdministratorRequest? InitialAdministrator { get; set; }
        public Guid Id { get; set; }
        public Guid Revision { get; set; }
        public string? ContactEmail { get; set; }
        public int MaxUsers { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public string HostName { get; set; } = string.Empty;
        public string SubscriptionTier { get; set; } = "Basic";
        public string Identifier { get; set; } = string.Empty;
        public Guid? DeploymentStampId { get; set; }
        public IReadOnlyList<string> ModuleKeys { get; set; } = [];
        

        public static TenantFormModel From(TenantResponse tenant)
            => new()
            {
                Id = tenant.Id,
                Revision = tenant.Revision,
                ContactEmail = tenant.ContactEmail,
                MaxUsers = tenant.MaxUsers,
                DisplayName = tenant.DisplayName,
                HostName = tenant.HostName,
                SubscriptionTier = tenant.SubscriptionTier,
                Identifier = tenant.Identifier
            };

        public CreateTenantRequest ToCreateRequest()
            => new()
            {
                DisplayName = DisplayName,
                ContactEmail = ContactEmail,
                MaxUsers = MaxUsers,
                HostName = HostName,
                SubscriptionTier = SubscriptionTier,
                Identifier = Identifier,
                DeploymentStampId = DeploymentStampId.GetValueOrDefault(),
                InitialAdministrator = InitialAdministrator,
                ModuleKeys = ModuleKeys
            };

        public UpdateTenantRequest ToUpdateRequest()
            => new()
            {
                Revision = Revision,
                DisplayName = DisplayName,
                ContactEmail = ContactEmail,
                MaxUsers = MaxUsers,
                HostName = HostName,
                SubscriptionTier = SubscriptionTier
            };
    }
}

