#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

[ "$1" = 0 ] || exit 0
[ "$(git config --local --bool --get basetemplate.localMigrations.enabled)" = true ] || exit 0
[ "$(git symbolic-ref --quiet --short HEAD)" = main ] || exit 0
[ "$(git rev-parse HEAD)" = "$(git rev-parse --verify --quiet refs/remotes/origin/main)" ] || exit 0

if ! git diff --quiet HEAD --; then
    echo "Local database update skipped because tracked files have uncommitted changes." >&2
    exit 0
fi

provider=$(git config --local --get basetemplate.localMigrations.provider) || provider=SqlServer
if ! pwsh -NoProfile -File scripts/update-local-database.ps1 -Provider "$provider" -Apply; then
    echo "Git updated main, but the local database update failed. Check the output and rerun scripts/update-local-database.ps1 with -Apply." >&2
    exit 1
fi
