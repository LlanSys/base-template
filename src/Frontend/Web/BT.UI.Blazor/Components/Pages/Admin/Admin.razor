@page "/admin"
@attribute [Authorize(Policy = "Tenant.Administration")]
@rendermode InteractiveServer
@inject IAuthSession AuthSession
<PageTitle>Admin Center | BaseTemplate</PageTitle>
<section class="dashboard-page">
    <div class="panel-heading">
        <h2>Admin Center</h2>
    </div>
    <MudList T="string"
             Dense="true">
        @if (AuthSession.HasPermission("tenant-settings.view"))
        {
            <MudListItem Href="/admin/org-settings"
                         Icon="@Icons.Material.Filled.Settings">Organization Settings</MudListItem>
        }
        @if (AuthSession.HasAnyPermission("users.view", "roles.view", "roles.manage_permissions"))
        {
            <MudListItem Href="/admin/iam"
                         Icon="@Icons.Material.Filled.Security">Users and Access</MudListItem>
        }
    </MudList>
</section>
