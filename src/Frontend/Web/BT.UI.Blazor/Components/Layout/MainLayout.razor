@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthSession AuthSession
@inject IAuditService AuditService
@using BT.UI.Blazor.Features.ControlPlane.Auditing.Contracts
@using BT.SharedKernel.Dtos.Common

<MudProviderHost />

<div class="page app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="workspace">
        <header class="app-top-row px-4">
            <div>
                <span class="top-kicker">@(AuthSession.CurrentUser?.IsPlatformStaff == true ? "Platform" : "Organization")</span>
                <strong>@(AuthSession.CurrentUser?.IsPlatformStaff == true ? "Control Panel" : AuthSession.CurrentUser?.OrganizationPreferences?.Name ?? "BaseTemplate")</strong>
            </div>
            <div class="topbar-meta">
                <UserProfileMenu />
            </div>
        </header>

        @if (_isImpersonating && _impersonationTarget != null)
        {
            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Filled"
                      Square="true"
                      Class="px-4 py-2 m-0"
                      Style="border-radius: 0;">
                <strong>Impersonation Active:</strong> You are currently impersonating tenant <strong>@_impersonationTarget</strong>. Actions are logged.
            </MudAlert>
        }

        <article class="content px-4">
            <RequireAuthenticated>
                @Body
            </RequireAuthenticated>
        </article>
    </main>
</div>

<SessionLifecycle />

<div id="blazor-error-ui"
     data-nosnippet>
    An unhandled error has occurred.
    <a href="."
       class="reload">Reload</a>
</div>

@code {
    private bool _isImpersonating;
    private string? _impersonationTarget;

    protected override void OnInitialized() => AuthSession.Changed += OnSessionChangedAsync;

    private Task OnSessionChangedAsync() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthSession.Changed -= OnSessionChangedAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthSession.InitializeAsync();
            if (AuthSession.IsAuthenticated && AuthSession.HasPermission("controlplane.impersonate"))
            {
                var response = await AuditService.GetImpersonationRecordsAsync(activeOnly: true);
                if (response.IsSuccess && response.Data != null)
                {
                    var currentUserId = AuthSession.CurrentUser?.AppUserId;
                    var activeSession = response.Data.FirstOrDefault(x => x.ActorId == currentUserId);
                    if (activeSession != null)
                    {
                        _isImpersonating = true;
                        _impersonationTarget = activeSession.TargetTenantName;
                        StateHasChanged();
                    }
                }
            }
        }
    }
}
