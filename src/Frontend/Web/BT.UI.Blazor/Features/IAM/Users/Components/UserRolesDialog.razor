@inject IIamAdminService IamAdminService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success"
                               Indeterminate="true" />
        }
        else if (_loaded)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">Select roles assigned to <strong>@DisplayName</strong>.</MudText>
                <div class="assignment-options">
                    @foreach (var group in _availableRoles.GroupBy(static role => role.ModuleKey ?? "Core", StringComparer.OrdinalIgnoreCase).OrderBy(static group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <fieldset class="assignment-group">
                            <legend>@group.Key</legend>
                            <div class="assignment-grid">
                                @foreach (var role in group)
                                {
                                    <div class="assignment-option"
                                         @key="role.Id">
                                        <MudCheckBox T="bool"
                                                     Value="@_selectedRoles.Contains(role.Name)"
                                                     ValueChanged="@((selected) => ToggleRole(role.Name, selected))"
                                                     Disabled="@(_isSaving || !CanToggle(role))"
                                                     Color="Color.Success"
                                                     Dense="true"
                                                     Label="@role.Name" />
                                        @if (!role.IsActive)
                                        {
                                            <small>Inactive</small>
                                        }
                                        else if (!CanToggle(role))
                                        {
                                            <small>Unavailable for this account</small>
                                        }
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    @if (_missingRoles.Count > 0)
                    {
                        <fieldset class="assignment-group">
                            <legend>Other Assigned Roles</legend>
                            <div class="assignment-grid">
                                @foreach (var role in _missingRoles)
                                {
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedRoles.Contains(role)"
                                                 ValueChanged="@((selected) => ToggleRole(role, selected))"
                                                 Disabled="@_isSaving"
                                                 Color="Color.Success"
                                                 Dense="true"
                                                 Label="@role" />
                                }
                            </div>
                        </fieldset>
                    }
                    @if (_availableRoles.Count == 0 && _missingRoles.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info"
                                  Dense="true">No roles are available in this scope.</MudAlert>
                    }
                </div>
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error"
                      Dense="true">Assignments could not be loaded. Close this dialog and try again.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close"
                   Variant="Variant.Text"
                   Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Success"
                   Disabled="@(!_loaded || _isSaving || _selectedRoles.SetEquals(_originalRoles))"
                   OnClick="SaveAsync">@(_isSaving ? "Saving..." : "Update")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<UserRoleOption> _availableRoles = [];
    private readonly List<string> _missingRoles = [];
    private readonly HashSet<string> _originalRoles = new(StringComparer.OrdinalIgnoreCase);
    private bool _loaded;
    private readonly HashSet<string> _selectedRoles = new(StringComparer.OrdinalIgnoreCase);
    private bool _isLoading = true;
    private bool _isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminUserListResponse User { get; set; } = default!;

    private string DisplayName => string.IsNullOrWhiteSpace(User.FullName) ? User.UserName : User.FullName;

    protected override async Task OnInitializedAsync()
    {
        var userRolesResponse = await IamAdminService.GetUserRolesAsync(User.Id);

        if (!userRolesResponse.IsSuccess || userRolesResponse.Data is null)
        {
            Snackbar.Add(userRolesResponse.Message ?? "We could not load user roles.", Severity.Error);
            _isLoading = false;
            return;
        }

        _originalRoles.UnionWith(userRolesResponse.Data.Roles);
        _selectedRoles.UnionWith(_originalRoles);
        _availableRoles.AddRange(userRolesResponse.Data.Options ?? []);
        _missingRoles.AddRange(_originalRoles
            .Except(_availableRoles.Select(static role => role.Name), StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase));
        _loaded = true;
        _isLoading = false;
    }

    private bool CanToggle(UserRoleOption role)
    {
        return _originalRoles.Contains(role.Name) || role.CanAssign;
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected)
        {
            _selectedRoles.Add(role);
            return;
        }

        _selectedRoles.Remove(role);
    }

    private async Task SaveAsync()
    {
        if (!_loaded || _isSaving || _selectedRoles.SetEquals(_originalRoles))
        {
            return;
        }

        _isSaving = true;
        var response = await IamAdminService.UpdateUserRolesAsync(User.Id, new UpdateUserRolesRequest([.. _selectedRoles.Order(StringComparer.OrdinalIgnoreCase)], [.. _originalRoles]));
        _isSaving = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "User role update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("User roles updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();
}
