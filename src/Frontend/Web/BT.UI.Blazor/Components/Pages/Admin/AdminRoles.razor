@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IIamAdminService IamAdminService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="list-toolbar">
    <MudTextField @bind-Value="_searchText"
                  Placeholder="Search role name..."
                  Label="Search roles"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Immediate="true" />
</div>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Success"
                       Indeterminate="true"
                       Class="my-2" />
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <MudAlert Severity="Severity.Error"
              Variant="Variant.Outlined"
              Dense="true"
              Class="my-2">@_message</MudAlert>
}

<div class="bt-table-scroll">
    <MudTable @ref="_table"
              Items="FilteredRoles"
              Dense="true"
              Hover="true"
              Elevation="0"
              FixedHeader="true"
              RowsPerPage="50"
              Height="calc(100vh - 24rem)"
              Style="min-width: 760px;"
              Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Role</MudTh>
            <MudTh>Scope</MudTh>
            <MudTh>Normalized</MudTh>
            <MudTh>Users</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Role">@context.Name</MudTd>
            <MudTd DataLabel="Scope">@context.DepartmentName</MudTd>
            <MudTd DataLabel="Normalized">@context.NormalizedName</MudTd>
            <MudTd DataLabel="Users">@context.UserCount</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Disabled")</MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <TableRowActions OnView="@(() => ShowRoleSummary(context))"
                                 OnEdit="@(() => OpenRoleDialogAsync(context))"
                                 OnDelete="@(() => ConfirmDeleteRoleAsync(context))"
                                 CanView="@AuthSession.HasPermission("roles.view")"
                                 CanEdit="@(AuthSession.HasPermission("roles.edit") && (!context.IsDefault || AuthSession.CurrentUser?.IsPlatformStaff == true))"
                                 CanDelete="@AuthSession.HasPermission("roles.delete")"
                                 DeleteDisabledReason="@(context.IsDefault ? "Default roles are required by BaseTemplate." : null)"
                                 ExtraActions="@RoleExtraActions(context)"
                                 OnExtraAction="@((action) => HandleRoleActionAsync(context, action))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Outlined"
                      Dense="true">No records found.</MudAlert>
        </NoRecordsContent>
        <PagerContent>
            <GlobalTablePager CurrentPage="(_table?.CurrentPage ?? 0) + 1"
                              TotalRecords="_table?.GetFilteredItemsCount() ?? 0"
                              PageSize="_table?.RowsPerPage ?? 50"
                              OnFirstPage="@(() => _table?.NavigateTo(0))"
                              OnPreviousPage="@(() => _table?.NavigateTo((_table?.CurrentPage ?? 1) - 1))"
                              OnNextPage="@(() => _table?.NavigateTo((_table?.CurrentPage ?? 0) + 1))" />
        </PagerContent>
    </MudTable>
</div>

@code {
    [Parameter] public string? ModuleKey { get; set; }
    private readonly List<AdminRoleListResponse> _roles = [];
    private bool _isLoading = true;
    private string? _message;
    private string? _searchText;
    private MudTable<AdminRoleListResponse>? _table;

    public Task OpenCreateDialogAsync() => OpenRoleDialogAsync(null);


    private IReadOnlyList<AdminRoleListResponse> FilteredRoles =>
        [.. _roles.Where(role => (ModuleKey == null || string.Equals(role.ModuleKey, ModuleKey, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_searchText) || role.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || role.NormalizedName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)))];

    private IReadOnlyList<string> RoleExtraActions(AdminRoleListResponse role)
    {
        var actions = new List<string>();
        if (AuthSession.HasPermission("roles.manage_permissions") && (!role.IsDefault || AuthSession.CurrentUser?.IsPlatformStaff == true))
            actions.Add("Manage permissions");
        if (AuthSession.HasPermission("roles.edit") && !role.IsDefault) actions.Add(role.IsActive ? "Disable" : "Enable");
        return actions;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        _message = null;
        StateHasChanged();

        var response = await IamAdminService.GetRolesAsync();
        if (!response.IsSuccess || response.Data is null)
        {
            _message = response.Message ?? "We could not load roles.";
            Snackbar.Add(_message, Severity.Error);
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _roles.Clear();
        _roles.AddRange(response.Data);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenRoleDialogAsync(AdminRoleListResponse? role)
    {
        var parameters = new DialogParameters
        {
            { nameof(RoleFormDialog.ExistingRole), role },
            { nameof(RoleFormDialog.ModuleKey), ModuleKey }
        };

        var dialog = await DialogService.ShowAsync<RoleFormDialog>(
            role is null ? "Create Role" : $"Edit - {role.Name}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadRolesAsync();
        }
    }

    private async Task ShowRoleSummary(AdminRoleListResponse role)
        => await DialogService.ShowAsync<RoleDetailsDialog>(role.Name, new DialogParameters
        { [nameof(RoleDetailsDialog.Role)] = role }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    private async Task HandleRoleActionAsync(AdminRoleListResponse role, string action)
    {
        if (action.Equals("Manage permissions", StringComparison.OrdinalIgnoreCase))
        {
            await OpenRolePermissionsDialogAsync(role);
            return;
        }

        if (await DialogService.ShowMessageBoxAsync(action + " role", $"{action} {role.Name} for its assigned users?", yesText: action, cancelText: "Cancel") != true) return;
        var response = await IamAdminService.UpdateRoleAsync(role.Id, new UpdateRoleRequest(role.Name, role.DepartmentId, !role.IsActive));
        if (!response.IsSuccess) Snackbar.Add(response.Message ?? "Role could not be changed.", Severity.Error);
        await LoadRolesAsync();
    }

    private async Task OpenRolePermissionsDialogAsync(AdminRoleListResponse role)
    {
        var parameters = new DialogParameters
        {
            { nameof(RolePermissionsDialog.Role), role }
        };

        await DialogService.ShowAsync<RolePermissionsDialog>(
            $"Permissions - {role.Name}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false });
    }

    private async Task ConfirmDeleteRoleAsync(AdminRoleListResponse role)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), $"Delete role {role.Name}? This will only proceed if no users or permission claims are assigned." },
            { nameof(ConfirmDialog.ConfirmText), "Delete" },
            { nameof(ConfirmDialog.ConfirmColor), Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Confirm Role Delete",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await IamAdminService.DeleteRoleAsync(role.Id);
        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Role delete failed.", Severity.Warning);
            return;
        }

        Snackbar.Add("Role deleted.", Severity.Success);
        await LoadRolesAsync();
    }
}
