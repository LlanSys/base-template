@page "/control-panel"
@layout ControlPlaneLayout
@inject IAuthSession AuthSession
<PageTitle>Control Panel | BaseTemplate</PageTitle>
<section class="dashboard-page">
    <div class="panel-heading">
        <h2>Control Panel</h2>
    </div>
    <MudText Class="mb-4">Manage deployment stamps, tenants, business modules, and vendor-owned access definitions.</MudText>
    <MudGrid Spacing="2">
        @if (AuthSession.HasPermission("controlplane.view_stamps"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/stamps">
                    <MudIcon Icon="@Icons.Material.Filled.Dns"
                             Size="Size.Small" />
                    <span>Deployment Stamps</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasPermission("controlplane.view_tenants"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/tenants">
                    <MudIcon Icon="@Icons.Material.Filled.Business"
                             Size="Size.Small" />
                    <span>Tenants</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasPermission("modules.view"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/modules">
                    <MudIcon Icon="@Icons.Material.Filled.Apps"
                             Size="Size.Small" />
                    <span>Modules</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasPermission("menus.view"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/menus">
                    <MudIcon Icon="@Icons.Material.Filled.Menu"
                             Size="Size.Small" />
                    <span>Menus</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasAnyPermission("roles.view", "roles.manage_permissions", "users.view"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/access">
                    <MudIcon Icon="@Icons.Material.Filled.Security"
                             Size="Size.Small" />
                    <span>Roles, Permissions, and Platform Staff</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasPermission("menus.view"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/access-catalog">
                    <MudIcon Icon="@Icons.Material.Filled.List"
                             Size="Size.Small" />
                    <span>Access Catalog</span>
                </a>
            </MudItem>
        }
        @if (AuthSession.HasPermission("controlplane.view_audit"))
        {
            <MudItem xs="12"
                     sm="6"
                     md="3">
                <a class="control-panel-tile"
                   href="/control-panel/audit">
                    <MudIcon Icon="@Icons.Material.Filled.History"
                             Size="Size.Small" />
                    <span>Audit Log</span>
                </a>
            </MudItem>
        }
    </MudGrid>
</section>
