@inject IOrgSettingsService OrgSettingsService
@inject ISnackbar Snackbar
@using BT.SharedKernel.Features.Shared.OrgSettings

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1">@Definition?.Label</MudText>
        <MudText Typo="Typo.body2"
                 Class="mb-3">@Definition?.Description</MudText>
        @if (Definition?.Kind == "TimeZone")
        {
            <MudSelect T="string"
                       @bind-Value="_value"
                       Label="Time zone"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var zone in TimeZoneInfo.GetSystemTimeZones())
                {
                    <MudSelectItem T="string"
                                   Value="@zone.Id">@zone.DisplayName</MudSelectItem>
                }
            </MudSelect>
        }
        else if (Definition?.Kind == "Culture")
        {
            <MudSelect T="string"
                       @bind-Value="_value"
                       Label="Regional format"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var culture in System.Globalization.CultureInfo.GetCultures(System.Globalization.CultureTypes.SpecificCultures).OrderBy(culture => culture.DisplayName))
                {
                    <MudSelectItem T="string"
                                   Value="@culture.Name">@culture.DisplayName</MudSelectItem>
                }
            </MudSelect>
        }
        else if (Definition?.Kind == "DateFormat")
        {
            <MudSelect T="string"
                       @bind-Value="_value"
                       Label="Date format"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var format in new[] {  "dd/MM/yyyy",  "MM/dd/yyyy",  "yyyy-MM-dd" }  )
                {
                    <MudSelectItem T="string"
                                   Value="@format">@format</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudTextField @bind-Value="_value"
                          Label="Value"
                          MaxLength="120"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close"
                   OnClick="@(() => Dialog.Cancel())"
                   Disabled="_busy">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public OrgSettingResponse ExistingSetting { get; set; } = default!;
    private OrganizationSettingDefinition? Definition => OrganizationSettingCatalog.Find(ExistingSetting.Key);
    private string _value = string.Empty;
    private bool _busy;
    protected override void OnInitialized() => _value = ExistingSetting.Value;
    private async Task SaveAsync()
    {
        if (!OrganizationSettingCatalog.IsValid(ExistingSetting.Key, _value)) { Snackbar.Add("Enter a valid value.", Severity.Warning); return; }
        _busy = true;
        var response = await OrgSettingsService.UpdateOrgSettingAsync(new UpdateOrgSettingRequest(ExistingSetting.Id, ExistingSetting.Key, _value, Definition?.Description));
        _busy = false;
        if (response.IsSuccess) Dialog.Close(DialogResult.Ok(true));
        else Snackbar.Add(response.Message ?? "Setting could not be saved.", Severity.Error);
    }
}
