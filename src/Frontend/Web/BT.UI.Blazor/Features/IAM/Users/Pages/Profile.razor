@page "/profile"
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Profile | Base Template</PageTitle>

<section class="profile-page"
         aria-label="Profile">
    @if (!_isReady)
    {
        <MudProgressLinear Indeterminate="true"
                           aria-label="Loading profile" />
    }
    else if (AuthSession.CurrentUser is { } user)
    {
        <MudPaper Class="poc-panel profile-overview"
                  Elevation="0">
            <div class="profile-identity">
                <MudAvatar Size="Size.Large"
                           Class="profile-avatar-large">
                    @if (ProfilePictureSource is not null)
                    {
                        <MudImage Src="@ProfilePictureSource"
                                  Alt=""
                                  ObjectFit="ObjectFit.Cover" />
                    }
                    else
                    {
                        @Initials
                    }
                </MudAvatar>
                <div>
                    <span class="eyebrow">Profile</span>
                    <h1>@DisplayName</h1>
                    <p>@PrimaryRole</p>
                </div>
            </div>

            <MudButton Href="/iam/security"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Security">Security Settings</MudButton>

            <div class="profile-upload-control">
                <label class="profile-upload-button"
                       for="profile-photo">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
                             Size="Size.Small" />
                    @(_isUploading ? "Uploading…" : "Change Photo")
                </label>
                <InputFile id="profile-photo"
                           class="visually-hidden"
                           aria-describedby="profile-photo-help"
                           OnChange="OnProfilePictureSelectedAsync"
                           accept="image/jpeg,image/png,image/webp"
                           disabled="@_isUploading" />
                <small id="profile-photo-help">JPEG, PNG, or WebP up to 10 MB.</small>
            </div>
        </MudPaper>

        <MudPaper Class="poc-panel profile-details"
                  Elevation="0">
            <div class="panel-heading">
                <h2>Account Details</h2>
            </div>
            <dl class="profile-details-grid">
                <div>
                    <dt>Username</dt>
                    <dd>@user.UserName</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@user.Email</dd>
                </div>
                <div>
                    <dt>Roles</dt>
                    <dd>@(user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "No roles assigned")</dd>
                </div>
                <div>
                    <dt>Two-Factor Authentication</dt>
                    <dd>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(user.TwoFactorEnabled ? Color.Success : Color.Default)">
                            @(user.TwoFactorEnabled ? "Enabled" : "Not enabled")
                        </MudChip>
                    </dd>
                </div>
            </dl>
        </MudPaper>
    }
</section>

@code {
    private bool _isReady;
    private bool _isUploading;
    private const long MaxProfilePictureBytes = 10_485_760;

    private string DisplayName
    {
        get
        {
            var fullName = $"{AuthSession.CurrentUser?.FirstName} {AuthSession.CurrentUser?.LastName}".Trim();
            return string.IsNullOrWhiteSpace(fullName) ? AuthSession.CurrentUser?.Email ?? "Signed-in user" : fullName;
        }
    }

    private string Initials
    {
        get
        {
            var first = AuthSession.CurrentUser?.FirstName;
            var last = AuthSession.CurrentUser?.LastName;
            if (!string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(last))
            {
                return $"{first[0]}{last[0]}".ToUpperInvariant();
            }

            var email = AuthSession.CurrentUser?.Email;
            return string.IsNullOrWhiteSpace(email) ? "BT" : email[..1].ToUpperInvariant();
        }
    }

    private string PrimaryRole => RoleDisplay.SelectPrimaryRole(AuthSession.CurrentUser?.Roles, "Signed in");

    private string? ProfilePictureSource => AuthSession.ProfilePictureDataUri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/iam/sign-in");
            return;
        }

        if (AuthSession.MfaEnrollmentRequired)
        {
            Snackbar.Add("Two-factor authentication setup is required before you can manage your profile.", Severity.Warning);
            Navigation.NavigateTo("/iam/security");
            return;
        }

        _isReady = true;
        StateHasChanged();
    }

    private async Task OnProfilePictureSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxProfilePictureBytes)
        {
            Snackbar.Add("Profile picture must be 10 MB or smaller.", Severity.Warning);
            return;
        }

        _isUploading = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxProfilePictureBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var response = await AuthService.UpdateProfilePictureAsync(
                memoryStream.ToArray(),
                file.Name,
                file.ContentType);

            if (!response.IsSuccess)
            {
                Snackbar.Add(response.Message ?? "Profile picture could not be updated.", Severity.Error);
                return;
            }

            await AuthSession.RefreshAsync();
            Snackbar.Add("Profile picture updated.", Severity.Success);
        }
        finally
        {
            _isUploading = false;
        }
    }
}
