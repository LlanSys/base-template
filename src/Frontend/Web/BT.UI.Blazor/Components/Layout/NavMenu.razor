@inject IAuthSession AuthSession
@inject IIamAdminService IamAdminService
@implements IDisposable

<div class="side-shell">
    <div class="brand-row">
        <a class="brand-lockup"
           href="/dashboard"
           aria-label="BaseTemplate dashboard">
            <span class="brand-mark"
                  aria-hidden="true">BT</span>
            <span>BaseTemplate</span>
        </a>
    </div>
    <input type="checkbox"
           title="Navigation menu"
           class="navbar-toggler" />
    <div class="nav-scrollable">
        <nav class="nav flex-column"
             aria-label="Main navigation">
            <NavLink class="nav-link"
                     href="/dashboard"
                     Match="NavLinkMatch.All">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                         Size="Size.Small" />Dashboard</NavLink>
            @if (AuthSession.CurrentUser?.IsPlatformStaff == true)
            {
                <AuthorizeView Policy="ControlPlane.Access">
                    <NavLink class="nav-link"
                             href="/control-panel">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                                 Size="Size.Small" />Control Panel</NavLink>
                </AuthorizeView>
            }
            else
            {
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true"
                                       Class="my-2" />
                }
                @if (_loadError is not null)
                {
                    <MudText Class="pa-2"
                             Typo="Typo.caption">@_loadError</MudText>
                }
                @foreach (var menu in _menus)
                {
                    <section class="nav-group">@RenderMenu(menu)</section>
                }
            }
        </nav>
    </div>
    @if (AuthSession.CurrentUser?.IsPlatformStaff == false)
    {
        <AuthorizeView Policy="Tenant.Administration">
            <div class="nav-admin-footer">
                <NavLink class="nav-link"
                         href="/admin">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                             Size="Size.Small" />Admin Center</NavLink>
            </div>
        </AuthorizeView>
    }
</div>

@code {
    private readonly List<MenuResponse> _menus = [];
    private bool _isLoading = true;
    private string? _loadError;

    protected override void OnInitialized() => AuthSession.Changed += OnSessionChangedAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthSession.InitializeAsync();
        await LoadMenusAsync();
    }

    private Task OnSessionChangedAsync() => InvokeAsync(LoadMenusAsync);

    private async Task LoadMenusAsync()
    {
        _menus.Clear();
        _loadError = null;
        if (AuthSession.IsAuthenticated && AuthSession.CurrentUser?.IsPlatformStaff == false)
        {
            var response = await IamAdminService.GetNavigationMenusAsync("Sidebar");
            if (response.IsSuccess && response.Data is not null)
                _menus.AddRange(response.Data.Where(menu => menu.Key is not ("dashboard" or "admin-center" or "control-panel" or "solution-overview" or "features")));
            else if (!response.IsSuccess) _loadError = "Menus unavailable.";
        }
        _isLoading = false;
        StateHasChanged();
    }

    public void Dispose() => AuthSession.Changed -= OnSessionChangedAsync;

    private RenderFragment RenderMenu(MenuResponse menu) => @<div>
        <NavLink class="nav-link" href="@menu.Url"><MudIcon Icon="@MenuIconMapper.Resolve(menu.Icon)" Size="Size.Small" />@menu.Title</NavLink>
        @if (menu.Children is { Count: > 0 })
        {
            <div class="nav-children">@foreach (var child in menu.Children) { @RenderMenu(child) }</div>
        }
    </div>;
}
