@page "/admin/org-settings"
@attribute [Authorize(Policy = "Tenant.Administration")]
@rendermode InteractiveServer
@inject IOrgSettingsService OrgSettingsService
@inject IAuthSession AuthSession
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using BT.SharedKernel.Features.Shared.OrgSettings

<PageTitle>Organization Settings | BaseTemplate</PageTitle>
<section class="dashboard-page">
    <MudButton Href="/admin"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               Class="mb-3">Admin Center</MudButton>
    <MudPaper Class="poc-panel"
              Elevation="0">
        <div class="panel-heading">
            <h2>Organization Settings</h2>
            <MudChip T="string"
                     Size="Size.Small">@_settings.Count shown</MudChip>
        </div>
        <MudText Typo="Typo.body2"
                 Class="mb-3">Changes apply after saving and refreshing the current view.</MudText>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        <div class="bt-table-scroll">
            <MudTable Items="_settings"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Setting</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Effect</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@OrganizationSettingCatalog.Find(context.Key)?.Label</MudTd>
                    <MudTd>@context.Value</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       title="Edit setting"
                                       Size="Size.Small"
                                       Disabled="@(!AuthSession.HasPermission("tenant-settings.update"))"
                                       OnClick="@(() => EditAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                                       title="Reset to default"
                                       Size="Size.Small"
                                       Disabled="@(context.Id == Guid.Empty || !AuthSession.HasPermission("tenant-settings.update"))"
                                       OnClick="@(() => ResetAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </MudPaper>
</section>

@code {
    private List<OrgSettingResponse> _settings = [];
    private bool _loading = true;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthSession.InitializeAsync();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var response = await OrgSettingsService.GetOrgSettingsAsync();
        if (response.IsSuccess && response.Data is not null) _settings = response.Data.ToList();
        else Snackbar.Add(response.Message ?? "Organization settings could not be loaded.", Severity.Error);
        _loading = false;
        StateHasChanged();
    }
    private async Task EditAsync(OrgSettingResponse setting)
    {
        var dialog = await DialogService.ShowAsync<OrgSettingFormDialog>("Edit organization setting",
            new DialogParameters { [nameof(OrgSettingFormDialog.ExistingSetting)] = setting },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false }) { await AuthSession.RefreshAsync(); await LoadAsync(); }
    }
    private async Task ResetAsync(OrgSettingResponse setting)
    {
        if (await DialogService.ShowMessageBoxAsync("Reset setting", "Restore the vendor-defined default?", yesText: "Reset", cancelText: "Cancel") != true) return;
        var response = await OrgSettingsService.DeleteOrgSettingAsync(setting.Id);
        if (!response.IsSuccess) Snackbar.Add(response.Message ?? "Reset failed.", Severity.Error);
        else { await AuthSession.RefreshAsync(); await LoadAsync(); }
    }
}
