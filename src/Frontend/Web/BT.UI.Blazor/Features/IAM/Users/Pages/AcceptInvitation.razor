@page "/iam/invitations/accept"
@layout AuthLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using BT.SharedKernel.Features.ControlPlane.Tenants.Dtos
@using BT.UI.Blazor.Features.Shared.BackendApi.Contracts.Interfaces
@inject IBackendApiClient Client
@inject IAuthSession AuthSession
@inject NavigationManager Navigation
<PageTitle>Accept your invitation | BaseTemplate</PageTitle>
<HeadContent>
    <meta name="referrer"
          content="no-referrer" />
</HeadContent>
<section class="auth-shell">
    <div class="auth-copy">
        <span class="eyebrow">Organization invitation</span>
        <h1>@(_preview is null ? "Review your invitation." : $"Welcome to {_preview.OrganizationName}.")</h1>
        <p>You have been invited to administer this organization. Accept the invitation and complete your account security to continue.</p>
    </div>
    <div class="auth-card">
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true"
                                 aria-label="Loading invitation" />
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger"
                 role="alert">@_error</div>
        }
        @if (_preview is not null)
        {
            <p>Invitation for <strong>@_preview.Email</strong>.</p>
            <p>@(_preview.ExistingAccount ? "Enter your current password to accept. Your password will remain unchanged." : "Create your password, then set up your authenticator.")</p>
            <EditForm Model="_form"
                      OnValidSubmit="AcceptAsync">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <label for="invitation-password">@(_preview.ExistingAccount ? "Current password" : "Create password")</label>
                    <InputText id="invitation-password"
                               type="password"
                               class="form-control form-control-lg"
                               @bind-Value="_form.Password"
                               autocomplete="@(_preview.ExistingAccount ? "current-password" : "new-password")" />
                    <ValidationMessage For="@(() => _form.Password)" />
                    @if (!_preview.ExistingAccount)
                    {
                        <p class="small">Use at least 8 characters, including uppercase and lowercase letters, a number and a symbol.</p>
                        <label for="invitation-confirm">Confirm password</label>
                        <InputText id="invitation-confirm"
                                   type="password"
                                   class="form-control form-control-lg"
                                   @bind-Value="_form.Confirmation"
                                   autocomplete="new-password" />
                    }
                    <button class="btn btn-bt-primary btn-lg"
                            type="submit"
                            disabled="@_busy">@(_busy ? "Accepting..." : "Accept invitation and continue")</button>
                </div>
            </EditForm>
            <BT.UI.Blazor.Features.IAM.Users.Components.ExternalSignInOptions InvitationId="@Id"
                                                                              InvitationToken="@Token" />
            <p class="small mt-3">If you did not expect this invitation, you can leave this page. Opening it does not activate access.</p>
        }
        <a href="/iam/sign-in">Back to sign in</a>
    </div>
</section>
@code {
    [SupplyParameterFromQuery(Name = "id")] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private AdministratorInvitationPreview? _preview;
    private readonly AcceptanceForm _form = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    protected override async Task OnParametersSetAsync()
    {
        _preview = null;
        _loading = true;
        if (Id == Guid.Empty || Token is not { Length: 64 }) _error = "This invitation is incomplete. Ask your administrator for a new link.";
        else
        {
            var response = await Client.SendAsync<AdministratorInvitationPreview>(HttpMethod.Post, "api/v1/iam/auth/invitations/inspect",
                new InspectAdministratorInvitationRequest(Id, Token), requiresAuthentication: false);
            if (response.IsSuccess) { _preview = response.Data; _error = null; }
            else _error = UserMessageSanitizer.Normalize(response.Message, "This invitation is unavailable. Ask your administrator for a new link.");
        }
        _loading = false;
    }
    private async Task AcceptAsync()
    {
        if (_busy || _preview is null) return;
        if (!_preview.ExistingAccount && !string.Equals(_form.Password, _form.Confirmation, StringComparison.Ordinal))
        { _error = "The passwords do not match."; return; }
        _busy = true;
        try
        {
            var response = await AuthSession.AcceptInvitationAsync(new AcceptAdministratorInvitationRequest(Id, Token ?? string.Empty, _form.Password));
            _form.Password = string.Empty;
            _form.Confirmation = string.Empty;
            if (!response.IsSuccess || response.Data is null) { _error = UserMessageSanitizer.Normalize(response.Message, "Your invitation could not be accepted. Please try again."); return; }
            Navigation.NavigateTo(response.Data.Requires2FA ? $"/iam/verify-2fa?userId={Uri.EscapeDataString(response.Data.UserId)}" : "/iam/security", replace: true);
        }
        finally { _busy = false; }
    }
    private sealed class AcceptanceForm
    {
        [Required, StringLength(1024)] public string Password { get; set; } = string.Empty;
        public string Confirmation { get; set; } = string.Empty;
    }
}
