@inject IIamAdminService IamAdminService
@inject ISnackbar Snackbar
@using BT.UI.Blazor.Features.IAM.Permissions

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Success"
                               Indeterminate="true" />
        }
        else if (_loaded)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">Manage permission keys assigned to <strong>@Role.Name</strong>.</MudText>
                <PermissionAssignmentList Permissions="_permissions"
                                          SelectedKeys="_selectedKeys"
                                          OriginalKeys="_originalKeys"
                                          IsSaving="_isSaving"
                                          OnToggle="TogglePermission" />
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error"
                      Dense="true">Assignments could not be loaded. Close this dialog and try again.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close"
                   Variant="Variant.Text"
                   Size="Size.Small"
                   OnClick="Cancel">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Success"
                   Disabled="@(!_loaded || _isSaving || _selectedKeys.SetEquals(_originalKeys))"
                   OnClick="SaveAsync">@(_isSaving ? "Saving..." : "Update")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<PermissionResponse> _permissions = [];
    private readonly HashSet<string> _selectedKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _originalKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool _isLoading = true;
    private bool _loaded;
    private bool _isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminRoleListResponse Role { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var permissionsResponse = await PermissionCatalogLoader.LoadAsync(IamAdminService, Role.DepartmentId);
        var rolePermissionsResponse = await IamAdminService.GetRolePermissionsAsync(Role.Id);

        if (!permissionsResponse.IsSuccess || permissionsResponse.Data is null)
        {
            Snackbar.Add(permissionsResponse.Message ?? "We could not load permissions.", Severity.Error);
            _isLoading = false;
            return;
        }

        if (!rolePermissionsResponse.IsSuccess || rolePermissionsResponse.Data is null)
        {
            Snackbar.Add(rolePermissionsResponse.Message ?? "We could not load role permissions.", Severity.Error);
            _isLoading = false;
            return;
        }

        _originalKeys.UnionWith(rolePermissionsResponse.Data.PermissionKeys);
        _selectedKeys.UnionWith(_originalKeys);
        _permissions.AddRange(permissionsResponse.Data.Where(permission => (permission.IsActive && (permission.DepartmentId is null || permission.DepartmentId == Role.DepartmentId)) || _originalKeys.Contains(permission.Key)));
        _loaded = true;
        _isLoading = false;
    }

    private void TogglePermission((string Key, bool Selected) selection)
    {
        var (key, selected) = selection;
        if (selected)
        {
            _selectedKeys.Add(key);
            return;
        }

        _selectedKeys.Remove(key);
    }

    private async Task SaveAsync()
    {
        if (!_loaded || _isSaving || _selectedKeys.SetEquals(_originalKeys))
        {
            return;
        }

        _isSaving = true;
        var response = await IamAdminService.UpdateRolePermissionsAsync(Role.Id, new UpdateRolePermissionsRequest([.. _selectedKeys.Order(StringComparer.OrdinalIgnoreCase)], [.. _originalKeys]));
        _isSaving = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Role permission update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Role permissions updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();
}
