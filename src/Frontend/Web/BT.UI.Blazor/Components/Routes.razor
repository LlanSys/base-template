@inject IAuthSession AuthSession
@if (!_sessionReady)
{
    <p role="status"
       class="pa-4">Checking your session...</p>
}
else
{
    <Router AppAssembly="typeof(Program).Assembly"
            NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData"
                                DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized Context="authenticationState">
                    @if (authenticationState.User.Identity?.IsAuthenticated == true)
                    {
                        <MudAlert Severity="Severity.Warning">You do not have permission to open this page.</MudAlert>
                        <MudButton Href="/dashboard"
                                   StartIcon="@Icons.Material.Filled.ArrowBack">Dashboard</MudButton>
                    }
                    else
                    {
                        Navigation.NavigateTo("/iam/sign-in", forceLoad: true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData"
                             Selector="h1" />
        </Found>
    </Router>
}

@code {
    private bool _sessionReady;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthSession.InitializeAsync();
        _sessionReady = true;
        StateHasChanged();
    }
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
