@page "/control-panel"
@layout ControlPlaneLayout
@inject IAuthSession AuthSession
<PageTitle>Control Panel | BaseTemplate</PageTitle>
<section class="dashboard-page">
    <div class="panel-heading">
        <h2>Control Panel</h2>
    </div>
    <MudText Class="mb-4">Manage deployment stamps, tenants, business modules, and vendor-owned access definitions.</MudText>
    <MudList T="string"
             Dense="true">
        @if (AuthSession.HasPermission("controlplane.view_stamps"))
        {
            <MudListItem Href="/control-panel/stamps"
                         Icon="@Icons.Material.Filled.Dns">Deployment Stamps</MudListItem>
        }
        @if (AuthSession.HasPermission("controlplane.view_tenants"))
        {
            <MudListItem Href="/control-panel/tenants"
                         Icon="@Icons.Material.Filled.Business">Tenants</MudListItem>
        }
        @if (AuthSession.HasPermission("modules.view"))
        {
            <MudListItem Href="/control-panel/modules"
                         Icon="@Icons.Material.Filled.Apps">Modules</MudListItem>
        }
        @if (AuthSession.HasPermission("menus.view"))
        {
            <MudListItem Href="/control-panel/menus"
                         Icon="@Icons.Material.Filled.Menu">Menus</MudListItem>
        }
        @if (AuthSession.HasAnyPermission("roles.view", "roles.manage_permissions", "users.view"))
        {
            <MudListItem Href="/control-panel/access"
                         Icon="@Icons.Material.Filled.Security">Roles, Permissions, and Platform Staff</MudListItem>
        }
        @if (AuthSession.HasPermission("menus.view"))
        {
            <MudListItem Href="/control-panel/access-catalog"
                         Icon="@Icons.Material.Filled.List">Access Catalog</MudListItem>
        }
        @if (AuthSession.HasPermission("controlplane.view_audit"))
        {
            <MudListItem Href="/control-panel/audit"
                         Icon="@Icons.Material.Filled.History">Audit Log</MudListItem>
        }
    </MudList>
</section>
