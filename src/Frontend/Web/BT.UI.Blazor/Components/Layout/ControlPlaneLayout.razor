@inherits LayoutComponentBase
@attribute [Authorize(Policy = "ControlPlane.Access")]

<AuthorizeView Policy="ControlPlane.Access">
    <Authorized>
        <MainLayout Body="@Body" />
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">You do not have access to platform administration.</MudAlert>
    </NotAuthorized>
</AuthorizeView>
