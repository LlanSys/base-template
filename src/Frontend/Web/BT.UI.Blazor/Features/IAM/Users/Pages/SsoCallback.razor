@page "/iam/sso-callback"
@layout AuthLayout
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject NavigationManager Navigation
@inject ILogger<SsoCallback> Logger
@inject ISnackbar Snackbar

<PageTitle>SSO Callback | Base Template</PageTitle>

<header class="auth-heading">
    <h1>@(_isError ? "Sign-in failed" : "Signing in…")</h1>
</header>

@if (_isError)
{
    <div class="alert alert-danger"
         role="alert">@_message</div>
    <a class="btn btn-outline-secondary mt-3"
       href="/iam/sign-in">Back to sign in</a>
}
else
{
    <div class="auth-progress"
         role="status">
        <MudProgressCircular Color="Color.Primary"
                             Indeterminate="true"
                             aria-label="Signing in" />
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ProcessCallbackAsync();
            StateHasChanged();
        }
    }

    private async Task ProcessCallbackAsync()
    {
        if (string.IsNullOrWhiteSpace(Code))
        {
            _isError = true;
            _message = "Sign-in could not be completed. Please try again.";
            return;
        }

        _isBusy = true;
        
        try
        {
            var response = await AuthSession.ExchangeSsoCodeAsync(Code);

            if (!response.IsSuccess || response.Data is null)
            {
                _isError = true;
                _message = GetDisplayMessage(response.Message, "We could not complete sign-in. Please try again or use another sign-in method.");
                Snackbar.Add(_message, Severity.Error);
                return;
            }

            if (response.Data.Requires2FA)
            {
                Navigation.NavigateTo($"/iam/verify-2fa?userId={Uri.EscapeDataString(response.Data.UserId)}", replace: true);
                return;
            }

            if (!AuthSession.IsAuthenticated)
            {
                _isError = true;
                _message = GetDisplayMessage(
                    AuthSession.LastError,
                    "We could not load your profile. Please sign in again.");
                Snackbar.Add(_message, Severity.Warning);
                return;
            }

            Navigation.NavigateTo(AuthSession.MfaEnrollmentRequired ? "/iam/security" : "/dashboard", replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while processing SSO callback.");
            _isError = true;
            _message = "Something went wrong while signing you in. Please try again or contact support.";
            Snackbar.Add(_message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetDisplayMessage(string? message, string fallback)
    {
        if (string.IsNullOrWhiteSpace(message)
            || string.Equals(message, "Operation Successful", StringComparison.OrdinalIgnoreCase))
        {
            return fallback;
        }

        return UserMessageSanitizer.Normalize(message, fallback);
    }
}
